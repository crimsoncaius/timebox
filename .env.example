# Backend (FastAPI)
DATABASE_URL=postgresql://timebox:timebox@localhost:5432/timebox
# IANA timezone used for "today", hour labels, and current-hour highlight
APP_TIMEZONE=America/New_York
# CORS: comma-separated origins, or * for dev
CORS_ORIGINS=http://localhost:5176,http://127.0.0.1:5176
# Optional regex for additional allowed origins.
# CORS_ORIGIN_REGEX=
# Optional shared secret. When set, every application endpoint requires a matching
# X-API-Key header (/health stays open). The Android app sends it; the web frontend
# does not, so leave this unset while using the browser UI.
# API_KEY=

# Frontend (Vite): base URL for API (empty = use /api proxy in dev)
VITE_API_BASE_URL=
# Target used by the Vite /api development proxy.
VITE_API_PROXY_TARGET=http://127.0.0.1:8001

# Dev / E2E only: create tables on API startup (do not use in production with Postgres)
# AUTO_CREATE_TABLES=1
